# .env.example — copy to .env.local for local runs. Never commit real values.

# Turso (libSQL). Local dev/test can use file:hitstreak.local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth. Required in production.
# BETTER_AUTH_SECRET: signs sessions/cookies — generate with `openssl rand -base64 32`
# BETTER_AUTH_URL: the site origin (e.g. https://hitstreak.app); http://localhost:3000 locally
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Cloudflare R2 (raw ingest archive). Optional locally — archiver disables itself without these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hitstreak-raw
